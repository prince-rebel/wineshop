<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajout des champs POS directement dans le group principal (toujours visible) -->
    <record id="view_warehouse_form_pos_store" model="ir.ui.view">
        <field name="name">stock.warehouse.form.pos.store</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">

            <!-- Injection dans le group principal, après le champ partner_id -->
            <xpath expr="//group/group[field[@name='partner_id']]" position="after">
                <group string="Boutique POS">
                    <field name="is_pos_store" string="Est un magasin POS"/>
                    <field name="responsible_user_id"
                           string="Responsable du magasin"
                           invisible="not is_pos_store"/>
                    <field name="central_warehouse_id"
                           string="Entrepôt central fournisseur"
                           invisible="not is_pos_store"
                           options="{'no_create': True}"
                           domain="[('is_pos_store', '=', False), ('company_id', '=', company_id)]"/>
                </group>
            </xpath>

            <!-- Bannière informative en haut du formulaire -->
            <xpath expr="//label[@for='name']" position="before">
                <div class="alert alert-info mb-2" role="alert"
                     invisible="not is_pos_store">
                    <i class="fa fa-store me-1"/>
                    Ce magasin est configuré comme <strong>boutique POS</strong>.
                    Il apparaîtra dans le wizard d'approvisionnement.
                </div>
            </xpath>

        </field>
    </record>

    <!-- Vue liste des entrepôts avec colonne POS -->
    <record id="view_warehouse_list_pos_store" model="ir.ui.view">
        <field name="name">stock.warehouse.list.pos.store</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-info">is_pos_store</attribute>
            </list>
            <field name="partner_id" position="after">
                <field name="is_pos_store" string="Magasin POS" optional="show"/>
                <field name="responsible_user_id" string="Responsable" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
