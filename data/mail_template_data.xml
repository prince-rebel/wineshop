<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template email alerte stock bas -->
    <record id="mail_template_low_stock_alert" model="mail.template">
        <field name="name">Alerte stock bas — Magasin POS</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="subject">⚠️ Rupture de stock — {{ object.warehouse_id.name }} — {{ object.product_id.display_name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email) | safe }}</field>
        <field name="email_to">{{ object.warehouse_id.central_warehouse_id.partner_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <div style="background-color: #e74c3c; color: white; padding: 20px; border-radius: 8px 8px 0 0;">
                    <h2 style="margin: 0;">⚠️ Alerte Rupture de Stock</h2>
                </div>
                <div style="background-color: #f9f9f9; padding: 20px; border: 1px solid #ddd;">
                    <p>Bonjour,</p>
                    <p>
                        Le stock du produit <strong><t t-out="object.product_id.display_name"/></strong>
                        dans le magasin <strong><t t-out="object.warehouse_id.name"/></strong>
                        est passé sous le seuil minimum.
                    </p>
                    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
                        <tr style="background-color: #3498db; color: white;">
                            <th style="padding: 10px; text-align: left;">Informations</th>
                            <th style="padding: 10px; text-align: right;">Valeur</th>
                        </tr>
                        <tr style="background-color: #fff;">
                            <td style="padding: 10px; border-bottom: 1px solid #eee;">Magasin</td>
                            <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: right;">
                                <t t-out="object.warehouse_id.name"/>
                            </td>
                        </tr>
                        <tr style="background-color: #f9f9f9;">
                            <td style="padding: 10px; border-bottom: 1px solid #eee;">Produit</td>
                            <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: right;">
                                <t t-out="object.product_id.display_name"/>
                            </td>
                        </tr>
                        <tr style="background-color: #fff;">
                            <td style="padding: 10px; border-bottom: 1px solid #eee;">Stock actuel</td>
                            <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: right; color: #e74c3c; font-weight: bold;">
                                <t t-out="object.qty_on_hand"/> <t t-out="object.product_uom.name"/>
                            </td>
                        </tr>
                        <tr style="background-color: #f9f9f9;">
                            <td style="padding: 10px; border-bottom: 1px solid #eee;">Seuil minimum</td>
                            <td style="padding: 10px; border-bottom: 1px solid #eee; text-align: right;">
                                <t t-out="object.product_min_qty"/> <t t-out="object.product_uom.name"/>
                            </td>
                        </tr>
                        <tr style="background-color: #fff;">
                            <td style="padding: 10px;">Quantité à commander</td>
                            <td style="padding: 10px; text-align: right; color: #27ae60; font-weight: bold;">
                                <t t-out="object.qty_to_order"/> <t t-out="object.product_uom.name"/>
                            </td>
                        </tr>
                    </table>
                    <div style="background-color: #f0f7ff; border-left: 4px solid #3498db; padding: 15px; margin: 20px 0;">
                        <strong>Action recommandée :</strong>
                        Créez un approvisionnement depuis le menu
                        <em>Inventaire &gt; Magasins POS &gt; Approvisionner un magasin</em>.
                    </div>
                    <p>Cordialement,<br/>Le système de gestion des stocks</p>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
