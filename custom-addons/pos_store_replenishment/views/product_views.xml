<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart button "Historique magasins" (F9) sur la fiche produit -->
    <record id="view_product_template_form_store_history" model="ir.ui.view">
        <field name="name">product.template.form.store.history</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_store_history"
                        string="Historique magasins"
                        icon="fa-history"
                        class="oe_stat_button"
                        type="object"
                        invisible="store_history_count == 0">
                    <field name="store_history_count" widget="statinfo" string="Magasins"/>
                </button>
            </div>

            <!-- Résumé toujours visible : combien vendu / combien en stock,
                 magasin par magasin. Affiché directement sur la fiche (pas
                 besoin de cliquer sur un bouton) pour des utilisateurs peu
                 familiers avec l'informatique. -->
            <div name="options" position="after">
                <div class="alert alert-info mt-2 mb-2" role="alert">
                    <strong>Ventes et stock par magasin</strong>
                    <field name="store_sales_summary" readonly="1" nolabel="1" class="d-block mt-1"/>
                </div>
            </div>
        </field>
    </record>

</odoo>
