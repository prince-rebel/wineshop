<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         F4 — Dashboard historique des transferts inter-magasins
    ══════════════════════════════════════════════════════════ -->

    <!-- Vue liste principale -->
    <record id="view_store_replenishment_dashboard_list" model="ir.ui.view">
        <field name="name">stock.picking.store.replenishment.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Historique des approvisionnements"
                  default_order="is_pending_store_validation desc, scheduled_date desc, id desc">
                <field name="scheduled_date" string="Date prévue"/>
                <field name="name" string="Référence"/>
                <field name="store_direction_label" string="Sens" widget="badge"
                       decoration-success="store_direction_label == 'in'"
                       decoration-warning="store_direction_label == 'out'"/>
                <field name="src_store_id" string="De" optional="show"/>
                <field name="dest_store_id" string="Vers"/>
                <field name="store_replenishment_status" string="Statut"/>
                <field name="state" column_invisible="1"/>
                <field name="is_store_replenishment" column_invisible="1"/>
                <field name="is_pending_store_validation" column_invisible="1"/>
                <field name="user_id" string="Validé par" optional="show"/>
                <field name="date_done" string="Date réception" optional="show"/>
                <button name="action_confirm_store_reception"
                        string="Confirmer la réception"
                        type="object"
                        class="btn-primary btn-sm"
                        invisible="state != 'assigned'"
                        confirm="Confirmez-vous la réception de ces marchandises ?"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire détaillée (simplifiée) -->
    <record id="view_store_replenishment_dashboard_form" model="ir.ui.view">
        <field name="name">stock.picking.store.replenishment.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Détail du transfert" create="false">
                <header>
                    <button name="action_confirm_store_reception"
                            string="✓ Confirmer la réception"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'assigned'"
                            confirm="Confirmez-vous la réception de toutes les marchandises ?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="waiting,assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transfert">
                            <field name="src_store_id" string="De" readonly="1"/>
                            <field name="dest_store_id" string="Vers" readonly="1"/>
                            <field name="scheduled_date" string="Date prévue" readonly="1"/>
                            <field name="store_replenishment_status" string="Statut" readonly="1"/>
                        </group>
                        <group string="Traitement">
                            <field name="user_id" string="Responsable" readonly="1"/>
                            <field name="date_done" string="Date de réception" readonly="1"/>
                            <field name="note" string="Remarques" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Produits transférés" name="moves">
                            <field name="move_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="product_id" string="Produit"/>
                                    <field name="product_uom_qty" string="Quantité demandée"/>
                                    <field name="quantity" string="Quantité réelle"/>
                                    <field name="product_uom" string="Unité"/>
                                    <field name="state" string="Statut"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue graphique — transferts par magasin -->
    <record id="view_store_replenishment_dashboard_graph" model="ir.ui.view">
        <field name="name">stock.picking.store.replenishment.graph</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <graph string="Approvisionnements par magasin" type="bar">
                <field name="dest_store_id" string="Magasin" type="row"/>
                <field name="id" string="Nombre de transferts" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vue pivot — analyse détaillée -->
    <record id="view_store_replenishment_dashboard_pivot" model="ir.ui.view">
        <field name="name">stock.picking.store.replenishment.pivot</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des approvisionnements">
                <field name="dest_store_id" type="row"/>
                <field name="scheduled_date" type="col" interval="month"/>
                <field name="id" type="measure" string="Nombre"/>
            </pivot>
        </field>
    </record>

    <!-- Action principale du dashboard -->
    <record id="action_store_replenishment_dashboard" model="ir.actions.act_window">
        <field name="name">Historique des approvisionnements</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="domain">[('is_store_replenishment', '=', True)]</field>
        <field name="context">{'group_by': ['validation_group']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun approvisionnement encore enregistré
            </p>
            <p>
                Utilisez le menu <b>Approvisionner un magasin</b> pour créer
                votre premier transfert de stock vers une boutique.
            </p>
        </field>
    </record>

    <record id="action_store_replenishment_dashboard_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_list"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard"/>
    </record>
    <record id="action_store_replenishment_dashboard_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_form"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard"/>
    </record>
    <record id="action_store_replenishment_dashboard_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_graph"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard"/>
    </record>
    <record id="action_store_replenishment_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_pivot"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard"/>
    </record>

    <!-- Filtres et regroupements pour le dashboard -->
    <record id="view_store_replenishment_search" model="ir.ui.view">
        <field name="name">stock.picking.store.replenishment.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Rechercher un approvisionnement">
                <field name="name" string="Référence"/>
                <field name="dest_store_id" string="Magasin destinataire"/>
                <field name="src_store_id" string="Magasin source"/>

                <filter name="filter_done" string="Reçus"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_in_progress" string="En cours"
                        domain="[('state', 'in', ['confirmed', 'assigned', 'waiting'])]"/>
                <filter name="filter_draft" string="Brouillons"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="group_dest_store" string="Par magasin destinataire"
                        context="{'group_by': 'dest_store_id'}"/>
                <filter name="group_src_store" string="Par magasin source"
                        context="{'group_by': 'src_store_id'}"/>
                <filter name="group_month" string="Par mois"
                        context="{'group_by': 'scheduled_date:month'}"/>
                <filter name="group_state" string="Par statut"
                        context="{'group_by': 'state'}"/>
                <filter name="group_validation" string="À valider / Déjà validé"
                        context="{'group_by': 'validation_group'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         Accès direct par magasin (1 clic, sans filtre à manipuler) —
         pour des utilisateurs peu familiers avec l'informatique.
         Les ids de magasins sont ceux de cette installation (fixes,
         entrepôts créés manuellement dans l'interface, pas via XML).
    ══════════════════════════════════════════════════════════ -->

    <record id="action_store_replenishment_dashboard_stock_principal" model="ir.actions.act_window">
        <field name="name">Historique — MAISON LAROV</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="domain">[('is_store_replenishment', '=', True), '|', ('dest_store_id', '=', 1), ('src_store_id', '=', 1)]</field>
        <field name="context">{'focus_warehouse_id': 1, 'group_by': ['validation_group']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun transfert encore enregistré pour ce magasin
            </p>
        </field>
    </record>
    <record id="action_store_replenishment_dashboard_stock_principal_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_list"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_stock_principal"/>
    </record>
    <record id="action_store_replenishment_dashboard_stock_principal_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_form"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_stock_principal"/>
    </record>
    <record id="action_store_replenishment_dashboard_stock_principal_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_graph"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_stock_principal"/>
    </record>
    <record id="action_store_replenishment_dashboard_stock_principal_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_pivot"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_stock_principal"/>
    </record>

    <record id="action_store_replenishment_dashboard_yop" model="ir.actions.act_window">
        <field name="name">Historique — Boutique Zino</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="domain">[('is_store_replenishment', '=', True), '|', ('dest_store_id', '=', 2), ('src_store_id', '=', 2)]</field>
        <field name="context">{'focus_warehouse_id': 2, 'group_by': ['validation_group']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun transfert encore enregistré pour ce magasin
            </p>
        </field>
    </record>
    <record id="action_store_replenishment_dashboard_yop_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_list"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_yop"/>
    </record>
    <record id="action_store_replenishment_dashboard_yop_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_form"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_yop"/>
    </record>
    <record id="action_store_replenishment_dashboard_yop_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_graph"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_yop"/>
    </record>
    <record id="action_store_replenishment_dashboard_yop_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_store_replenishment_dashboard_pivot"/>
        <field name="act_window_id" ref="action_store_replenishment_dashboard_yop"/>
    </record>

    <!-- BCG DOKUI / BCG ANGRE (ids 3/4) retirés : entrepôts hérités d'une
         installation précédente, inexistants dans la base LAROV. -->

</odoo>
