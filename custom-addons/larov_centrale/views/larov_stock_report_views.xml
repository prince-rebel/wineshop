<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Assistant : États de stock LAROV ─────────────────────────────── -->
    <record id="view_larov_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">larov.stock.report.wizard.form</field>
        <field name="model">larov.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="États de stock LAROV">
                <group>
                    <group>
                        <field name="report_type" widget="radio"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="region_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="only_wines" invisible="report_type == 'valuation'"/>
                        <field name="include_zero_stock" invisible="report_type == 'valuation'"/>
                        <field name="history_months" invisible="report_type != 'replenishment'"/>
                        <field name="coverage_months" invisible="report_type != 'replenishment'"/>
                    </group>
                </group>
                <footer>
                    <button name="action_open" string="Afficher" type="object" class="btn-primary"/>
                    <button name="action_print" string="Imprimer (PDF)" type="object" class="btn-secondary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_larov_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">États de stock LAROV</field>
        <field name="res_model">larov.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── Inventaire en valeur : liste + pivot (dépôts en colonnes) ──────── -->
    <record id="view_larov_stock_valuation_report_list" model="ir.ui.view">
        <field name="name">larov.stock.valuation.report.list</field>
        <field name="model">larov.stock.valuation.report</field>
        <field name="arch" type="xml">
            <list string="Inventaire en valeur" create="false" edit="false" delete="false" default_order="value desc">
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="wine_region_id" optional="show"/>
                <field name="wine_color" optional="show"/>
                <field name="vintage" optional="hide"/>
                <field name="supplier_id" optional="show"/>
                <field name="warehouse_id"/>
                <field name="establishment_type" optional="hide"/>
                <field name="quantity" sum="Quantité"/>
                <field name="unit_cost" groups="stock.group_stock_manager"/>
                <field name="value" sum="Valeur totale" groups="stock.group_stock_manager"/>
                <field name="product_id" column_invisible="1"/>
                <field name="categ_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_larov_stock_valuation_report_pivot" model="ir.ui.view">
        <field name="name">larov.stock.valuation.report.pivot</field>
        <field name="model">larov.stock.valuation.report</field>
        <field name="arch" type="xml">
            <pivot string="Inventaire en valeur" display_quantity="true">
                <field name="product_name" type="row"/>
                <field name="warehouse_id" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="value" type="measure" groups="stock.group_stock_manager"/>
            </pivot>
        </field>
    </record>

    <record id="view_larov_stock_valuation_report_graph" model="ir.ui.view">
        <field name="name">larov.stock.valuation.report.graph</field>
        <field name="model">larov.stock.valuation.report</field>
        <field name="arch" type="xml">
            <graph string="Valeur du stock" type="pie">
                <field name="wine_region_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_larov_stock_valuation_report_search" model="ir.ui.view">
        <field name="name">larov.stock.valuation.report.search</field>
        <field name="model">larov.stock.valuation.report</field>
        <field name="arch" type="xml">
            <search string="Inventaire en valeur">
                <field name="product_name"/>
                <field name="product_code"/>
                <field name="warehouse_id"/>
                <field name="wine_region_id"/>
                <field name="supplier_id"/>
                <filter string="Dépôt central" name="central" domain="[('establishment_type', '=', 'central')]"/>
                <filter string="Boutiques" name="shops" domain="[('establishment_type', '=', 'shop')]"/>
                <filter string="Dépôts-vente CHR" name="deposits" domain="[('establishment_type', '=', 'chr_deposit')]"/>
                <group>
                    <filter string="Produit" name="groupby_product" context="{'group_by': 'product_name'}"/>
                    <filter string="Établissement" name="groupby_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Région" name="groupby_region" context="{'group_by': 'wine_region_id'}"/>
                    <filter string="Couleur" name="groupby_color" context="{'group_by': 'wine_color'}"/>
                    <filter string="Fournisseur" name="groupby_supplier" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_larov_stock_valuation_report" model="ir.actions.act_window">
        <field name="name">Inventaire en valeur</field>
        <field name="res_model">larov.stock.valuation.report</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="view_larov_stock_valuation_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Aucun stock valorisé</p>
            <p>Quantité × coût de revient (CMUP) par produit et par établissement.
               Utilisez « Insérer dans feuille de calcul » pour reproduire le tableau Excel.</p>
        </field>
    </record>

    <!-- ── Fiche commerciale : liste produits ─────────────────────────────── -->
    <record id="view_larov_commercial_sheet_list" model="ir.ui.view">
        <field name="name">product.product.list.larov.commercial.sheet</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Fiche commerciale" create="false" edit="false" delete="false"
                  decoration-muted="qty_available &lt;= 0">
                <field name="default_code" string="Réf."/>
                <field name="name" string="Désignation"/>
                <field name="estate" optional="show"/>
                <field name="wine_region_id"/>
                <field name="wine_color" optional="show"/>
                <field name="vintage" optional="show"/>
                <field name="qty_available" string="Stock disponible" sum="Total"/>
                <field name="price_chr"/>
                <field name="price_takeaway"/>
                <field name="incoming_po_qty" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_larov_commercial_sheet" model="ir.actions.act_window">
        <field name="name">Fiche commerciale</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_larov_commercial_sheet_list"/>
        <field name="domain">[('sale_ok', '=', True), ('type', '=', 'consu')]</field>
        <field name="context">{'search_default_groupby_region': 1}</field>
    </record>

    <!-- ── Réapprovisionnement : liste produits ───────────────────────────── -->
    <record id="view_larov_replenishment_list" model="ir.ui.view">
        <field name="name">product.product.list.larov.replenishment</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Réapprovisionnement" create="false" edit="false" delete="false"
                  decoration-danger="suggested_order_qty > 0" decoration-muted="monthly_sales_qty == 0">
                <field name="default_code" string="Réf."/>
                <field name="name" string="Désignation"/>
                <field name="wine_region_id"/>
                <field name="qty_available" string="Stock disponible" sum="Total"/>
                <field name="monthly_sales_qty" sum="Total"/>
                <field name="alert_stock_qty" sum="Total"/>
                <field name="stockout_estimate_months"/>
                <field name="incoming_po_qty" sum="Total"/>
                <field name="suggested_order_qty" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_larov_replenishment_report" model="ir.actions.act_window">
        <field name="name">Rapport de réapprovisionnement</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_larov_replenishment_list"/>
        <field name="domain">[('sale_ok', '=', True), ('type', '=', 'consu')]</field>
    </record>
</odoo>
