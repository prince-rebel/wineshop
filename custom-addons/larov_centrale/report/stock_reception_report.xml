<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════════
         BON DE RÉCEPTION D'ARRIVAGE FOURNISSEUR — format LAROV
         Source : LAROV_Template_Bon_Reception FOURNISSEUR.xlsx
    ══════════════════════════════════════════════════════════════════ -->
    <template id="report_stock_reception_larov_document">
        <t t-call="web.external_layout">
            <t t-set="po" t-value="doc.purchase_id"/>
            <t t-set="company_cur" t-value="doc.company_id.currency_id"/>
            <t t-set="po_cur" t-value="po and po.currency_id or company_cur"/>
            <t t-set="sym" t-value="po_cur.symbol"/>
            <t t-set="moves" t-value="doc.move_ids.filtered(lambda m: m.state != 'cancel')"/>
            <t t-set="qty_ordered" t-value="sum(moves.mapped('product_uom_qty'))"/>
            <t t-set="qty_received" t-value="sum(moves.mapped('quantity'))"/>
            <div class="page larov-doc">
                <t t-call="larov_centrale.larov_doc_header">
                    <t t-set="title">BON DE RÉCEPTION D'ARRIVAGE FOURNISSEUR</t>
                    <t t-set="subtitle" t-value="doc.state != 'done' and 'PROVISOIRE — réception non validée' or ''"/>
                </t>

                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <td style="width:50%; vertical-align:top; padding-right:8px;">
                            <t t-call="larov_centrale.larov_info_block">
                                <t t-set="block_title">ARRIVAGE</t>
                                <t t-set="rows" t-value="[
                                    ('Fournisseur', doc.partner_id.display_name),
                                    ('Transitaire', doc.forwarder_id.name),
                                    ('Mode de transport', doc.transport_mode_label),
                                    ('Date d\'arrivée en dépôt', (doc.date_done or doc.scheduled_date) and (doc.date_done or doc.scheduled_date).strftime('%d/%m/%Y')),
                                    ('État général du chargement', doc.cargo_condition),
                                ]"/>
                            </t>
                        </td>
                        <td style="width:50%; vertical-align:top; padding-left:8px;">
                            <t t-call="larov_centrale.larov_info_block">
                                <t t-set="block_title">RÉFÉRENCES DOCUMENTAIRES</t>
                                <t t-set="rows" t-value="[
                                    ('N° de réception', doc.name),
                                    ('Réf. bon de commande', po and po.name or doc.origin),
                                    ('N° facture fournisseur', doc.supplier_invoice_ref or (po and po.partner_ref)),
                                    ('N° conteneur / B/L', doc.container_ref),
                                    ('Taux de change  1 %s =' % sym, po and company_cur != po_cur and '%s %s' % ('{:,.0f}'.format(po.exchange_rate_xof).replace(',', ' '), company_cur.symbol) or '—'),
                                ]"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <table class="larov-lines">
                    <thead>
                        <tr>
                            <th>Appellation</th>
                            <th>Domaine</th>
                            <th>Couleur</th>
                            <th class="ctr">Mill.</th>
                            <th class="num">Qté commandée</th>
                            <th class="num">Qté reçue</th>
                            <th class="num">Casse / manquant</th>
                            <th class="num">Écart</th>
                            <th class="num">P.U. achat <t t-esc="sym"/></th>
                            <th class="num">Valeur reçue <t t-esc="sym"/></th>
                            <th>Dépôt d'entrée</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="total_value" t-value="0.0"/>
                        <t t-foreach="moves" t-as="move">
                            <t t-set="pu" t-value="move.purchase_line_id.price_unit or 0.0"/>
                            <t t-set="total_value" t-value="total_value + move.quantity * pu"/>
                            <tr t-att-class="move.qty_gap and 'larov-neg' or ''">
                                <td><t t-esc="move.product_id.product_tmpl_id._get_larov_appellation()"/></td>
                                <td><t t-esc="move.estate or ''"/></td>
                                <td><t t-esc="move.product_id.wine_color_display"/></td>
                                <td class="ctr"><t t-esc="move.vintage_display"/></td>
                                <td class="num"><t t-esc="'{:,.0f}'.format(move.product_uom_qty).replace(',', ' ')"/></td>
                                <td class="num"><t t-esc="'{:,.0f}'.format(move.quantity).replace(',', ' ')"/></td>
                                <td class="num"><t t-esc="move.qty_damaged and '{:,.0f}'.format(move.qty_damaged) or ''"/></td>
                                <td class="num"><t t-esc="move.qty_gap and '{:+,.0f}'.format(move.qty_gap) or ''"/></td>
                                <td class="num"><t t-esc="pu" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="num"><t t-esc="move.quantity * pu" t-options='{"widget": "monetary", "display_currency": po_cur}'/></td>
                                <td><t t-esc="move.location_dest_id.warehouse_id.name or move.location_dest_id.display_name"/></td>
                            </tr>
                        </t>
                        <tr class="larov-total">
                            <td colspan="4" class="num">TOTAL</td>
                            <td class="num"><t t-esc="'{:,.0f}'.format(qty_ordered).replace(',', ' ')"/></td>
                            <td class="num"><t t-esc="'{:,.0f}'.format(qty_received).replace(',', ' ')"/></td>
                            <td class="num"><t t-esc="'{:,.0f}'.format(doc.total_damaged_qty)"/></td>
                            <td class="num"><t t-esc="'{:+,.0f}'.format(doc.total_gap_qty)"/></td>
                            <td></td>
                            <td class="num"><t t-esc="total_value" t-options='{"widget": "monetary", "display_currency": po_cur}'/></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="6" style="border:none; color:#555;">
                                <t t-if="po and company_cur != po_cur">
                                    Contre-valeur : <b><t t-esc="total_value * po.exchange_rate_xof" t-options='{"widget": "monetary", "display_currency": company_cur}'/></b>
                                </t>
                            </td>
                            <td colspan="2" style="border:none; text-align:right; color:#555;">Taux de casse</td>
                            <td colspan="3" style="border:none; font-weight:700;"><t t-esc="'{:.2f} %'.format(doc.damage_rate * 100)"/></td>
                        </tr>
                    </tbody>
                </table>

                <div t-if="not doc.total_gap_qty" class="larov-note-ok">
                    ✓ Réception conforme à la commande — aucun écart constaté.
                </div>
                <div t-else="" class="larov-note-warn">
                    ⚠ ÉCART DE <t t-esc="'{:+,.0f}'.format(doc.total_gap_qty)"/> BOUTEILLE(S) —
                    réserve à formuler auprès du fournisseur et du transitaire sous 48 h.
                </div>

                <div class="larov-section">RÉSERVES ET OBSERVATIONS</div>
                <div class="larov-box"><t t-esc="doc.reception_remarks or ''"/></div>

                <t t-call="larov_centrale.larov_signatures">
                    <t t-set="signatures" t-value="[
                        ('RÉCEPTIONNÉ PAR — magasinier', doc.prepared_by_name),
                        ('CONTRÔLÉ PAR — responsable stocks', doc.checked_by_name),
                        ('VISA — Direction générale', ''),
                    ]"/>
                </t>

                <div class="larov-footnote">
                    Toute casse ou manquant doit être photographié et signalé au transitaire dans les 48 heures
                    suivant la réception. Les quantités reçues — et non commandées — sont celles saisies en entrée de stock.
                </div>
            </div>
        </t>
    </template>

    <template id="report_stock_reception_larov">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="larov_centrale.report_stock_reception_larov_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_stock_reception_larov" model="ir.actions.report">
        <field name="name">Bon de réception d'arrivage (LAROV)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">larov_centrale.report_stock_reception_larov</field>
        <field name="report_file">larov_centrale.report_stock_reception_larov</field>
        <field name="print_report_name">'REC-%s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
