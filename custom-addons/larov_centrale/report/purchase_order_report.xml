<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════════
         BON DE COMMANDE FOURNISSEUR — format LAROV
         Source : LAROV_Template_Bon_Commande Fournisseur.xlsx
    ══════════════════════════════════════════════════════════════════ -->
    <template id="report_purchase_order_larov_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="settings" t-value="doc.env['larov.settings']"/>
            <t t-set="company_cur" t-value="doc.company_id.currency_id"/>
            <t t-set="sym" t-value="doc.currency_id.symbol"/>
            <div class="page larov-doc">
                <t t-call="larov_centrale.larov_doc_header">
                    <t t-set="title">BON DE COMMANDE FOURNISSEUR</t>
                    <t t-set="subtitle" t-value="doc.state in ('draft', 'sent') and 'DEMANDE DE PRIX — en attente d\'approbation' or ''"/>
                </t>

                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <td style="width:50%; vertical-align:top; padding-right:8px;">
                            <t t-call="larov_centrale.larov_info_block">
                                <t t-set="block_title">FOURNISSEUR</t>
                                <t t-set="rows" t-value="[
                                    ('Fournisseur', doc.partner_id.display_name),
                                    ('Contact', doc.partner_id.email or doc.partner_id.phone),
                                    ('Transitaire retenu', doc.forwarder_id.name),
                                    ('Incoterm / livraison', doc.delivery_terms or (doc.incoterm_id and doc.incoterm_id.name)),
                                    ('Taux de change  1 %s =' % sym, company_cur != doc.currency_id and '%s %s' % ('{:,.0f}'.format(doc.exchange_rate_xof).replace(',', ' '), company_cur.symbol) or '—'),
                                ]"/>
                            </t>
                        </td>
                        <td style="width:50%; vertical-align:top; padding-left:8px;">
                            <t t-call="larov_centrale.larov_info_block">
                                <t t-set="block_title">COMMANDE</t>
                                <t t-set="rows" t-value="[
                                    ('N° de commande', doc.name),
                                    ('Date de commande', doc.date_approve and doc.date_approve.strftime('%d/%m/%Y') or doc.date_order.strftime('%d/%m/%Y')),
                                    ('Couverture visée', '%g mois' % doc.target_coverage_months),
                                    ('Arrivée prévue', doc.expected_arrival_date and doc.expected_arrival_date.strftime('%d/%m/%Y') or (doc.date_planned and doc.date_planned.strftime('%d/%m/%Y'))),
                                    ('Bouteilles par carton', doc.bottles_per_case),
                                ]"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <table class="larov-lines">
                    <thead>
                        <tr>
                            <th>Appellation</th>
                            <th>Domaine</th>
                            <th>Région</th>
                            <th>Couleur</th>
                            <th class="ctr">Mill.</th>
                            <th class="num">Qté (bt)</th>
                            <th class="num">Cartons</th>
                            <th class="num">P.U. achat <t t-esc="sym"/></th>
                            <th class="num">Montant <t t-esc="sym"/></th>
                            <th class="num">Stock actuel</th>
                            <th class="num">Couverture (mois)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="doc.order_line.filtered(lambda l: not l.display_type)"/>
                        <t t-foreach="lines" t-as="line">
                            <tr t-att-class="line.coverage_warning and 'larov-warning' or ''">
                                <td><t t-esc="line.product_id.product_tmpl_id._get_larov_appellation()"/></td>
                                <td><t t-esc="line.estate or ''"/></td>
                                <td><t t-esc="line.wine_region_id.name or ''"/></td>
                                <td><t t-esc="line.product_id.wine_color_display"/></td>
                                <td class="ctr"><t t-esc="line.vintage_display"/></td>
                                <td class="num"><t t-esc="'{:,.0f}'.format(line.product_qty).replace(',', ' ')"/></td>
                                <td class="num"><t t-esc="line.cases_qty"/></td>
                                <td class="num"><t t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="num"><t t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                <td class="num"><t t-esc="'{:,.0f}'.format(line.qty_stock_current).replace(',', ' ')"/></td>
                                <td class="num"><t t-esc="line.monthly_sales_qty and '%.1f' % line.coverage_after_receipt or 'n.d.'"/></td>
                            </tr>
                        </t>
                        <tr class="larov-total">
                            <td colspan="5" class="num">TOTAL</td>
                            <td class="num"><t t-esc="'{:,.0f}'.format(doc.total_bottles).replace(',', ' ')"/></td>
                            <td class="num"><t t-esc="doc.total_cases"/></td>
                            <td></td>
                            <td class="num"><t t-esc="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            <td colspan="2"></td>
                        </tr>
                        <tr t-if="company_cur != doc.currency_id">
                            <td colspan="8" style="border:none; text-align:right; color:#555;">Contre-valeur au taux du jour</td>
                            <td class="num" style="border:none; font-weight:700;"><t t-esc="doc.amount_total_xof" t-options='{"widget": "monetary", "display_currency": company_cur}'/></td>
                            <td colspan="2" style="border:none;"></td>
                        </tr>
                    </tbody>
                </table>

                <div class="larov-section">SUIVI DE LA COMMANDE</div>
                <table class="larov-tracking">
                    <tr>
                        <td><div class="larov-track-label">Commande passée</div>
                            <div class="larov-track-value"><t t-esc="doc.date_approve and doc.date_approve.strftime('%d/%m/%Y') or '____ / ____ / ______'"/></div></td>
                        <td><div class="larov-track-label">Paiement acompte 30 %</div>
                            <div class="larov-track-value"><t t-esc="doc.date_deposit_paid and doc.date_deposit_paid.strftime('%d/%m/%Y') or '____ / ____ / ______'"/></div></td>
                        <td><div class="larov-track-label">Enlèvement / départ</div>
                            <div class="larov-track-value"><t t-esc="doc.date_pickup and doc.date_pickup.strftime('%d/%m/%Y') or '____ / ____ / ______'"/></div></td>
                    </tr>
                    <tr>
                        <td><div class="larov-track-label">Embarquement</div>
                            <div class="larov-track-value"><t t-esc="doc.date_shipped and doc.date_shipped.strftime('%d/%m/%Y') or '____ / ____ / ______'"/></div></td>
                        <td><div class="larov-track-label">Arrivée Abidjan</div>
                            <div class="larov-track-value"><t t-esc="doc.date_arrived_port and doc.date_arrived_port.strftime('%d/%m/%Y') or '____ / ____ / ______'"/></div></td>
                        <td><div class="larov-track-label">Réception en dépôt</div>
                            <div class="larov-track-value"><t t-esc="doc.date_received_warehouse and doc.date_received_warehouse.strftime('%d/%m/%Y') or '____ / ____ / ______'"/></div></td>
                    </tr>
                </table>

                <t t-call="larov_centrale.larov_signatures">
                    <t t-set="signatures" t-value="[
                        ('ÉTABLI PAR', doc.user_id.name),
                        ('APPROUVÉ PAR — Direction générale', ''),
                    ]"/>
                </t>

                <div class="larov-footnote">
                    Aucune commande n'est transmise au fournisseur sans l'approbation de la Direction générale.
                    La couverture visée est de <t t-esc="'%g' % doc.target_coverage_months"/> mois :
                    toute référence dont la couverture dépasse <t t-esc="'%g' % settings.max_coverage_months()"/> mois
                    après réception doit être justifiée.
                </div>
            </div>
        </t>
    </template>

    <template id="report_purchase_order_larov">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="larov_centrale.report_purchase_order_larov_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_purchase_order_larov" model="ir.actions.report">
        <field name="name">Bon de commande fournisseur (LAROV)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">larov_centrale.report_purchase_order_larov</field>
        <field name="report_file">larov_centrale.report_purchase_order_larov</field>
        <field name="print_report_name">'BC-%s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
